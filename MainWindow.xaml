<Window x:Class="ExtractAudioFromVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extract Audio from Video"
        Icon="/extract-audio-from-video-app-icon.ico"
        Width="720"
        Height="488"
        MinWidth="600"
        MinHeight="438"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Extract Audio from Video" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#FF5F6368"
                       Text="Extracts the first audio track as an AAC file in M4A format." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Video file" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VideoPathTextBox"
                         Grid.Column="0"
                         Height="36"
                         Padding="9,7"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center" />
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        MinWidth="110"
                        Height="36"
                        Margin="10,0,0,0"
                        Padding="12,0"
                        Click="BrowseButton_Click"
                        Content="Browse..." />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Output name (without .m4a)" />
            <TextBox x:Name="OutputNameTextBox"
                     Height="36"
                     Padding="9,7"
                     VerticalContentAlignment="Center" />
            <TextBlock Margin="0,7,0,0"
                       Foreground="#FF5F6368"
                       Text="The file is saved next to the video. If the name already exists, a number is added." />
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="3"
                   Margin="0,18,0,18"
                   Foreground="#FF5F6368"
                   Text="Select a video file."
                   TextWrapping="Wrap"
                   VerticalAlignment="Top" />

        <Grid x:Name="ProgressPanel"
              Grid.Row="4"
              Margin="0,0,0,16"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ExtractionProgressBar"
                         Grid.Column="0"
                         Height="14"
                         Maximum="100"
                         Minimum="0"
                         VerticalAlignment="Center" />
            <TextBlock x:Name="ProgressPercentTextBlock"
                       Grid.Column="1"
                       MinWidth="56"
                       Margin="12,0,0,0"
                       Foreground="#FF5F6368"
                       Text="..."
                       TextAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <Button x:Name="ExtractButton"
                Grid.Row="5"
                Width="190"
                Height="42"
                HorizontalAlignment="Right"
                Click="ExtractButton_Click"
                Content="Extract Audio"
                IsEnabled="False" />
    </Grid>
</Window>
